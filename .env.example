## Environment variables for Docker Compose / backend
#
# Copy this file to `.env` in the project root and fill in the values.
# Do NOT commit your real `.env` (it contains secrets).
#
# Used by:
# - `docker-compose.yml` (env_file: .env)
# - `backend/src/main/resources/application.properties` via Spring env injection
#

# Supabase / PostgreSQL connection (example placeholders)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# Hibernate schema strategy (dev-friendly default)
# - update: auto-create/update tables from @Entity classes
# - validate: fail if schema doesn't match entities
# - none: don't touch schema
SPRING_JPA_HIBERNATE_DDL_AUTO=update

